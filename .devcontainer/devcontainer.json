{
  "name": "FIN323",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "GitHub.copilot",
        "mathematic.vscode-pdf"
      ]
    }
  },
  "secrets": {
    "WRDS_USERNAME": {
      "description": "Your WRDS username for accessing financial data"
    },
    "FRED_API_KEY": {
      "description": "Your FRED API key for accessing economic data"
    }
  }
}
